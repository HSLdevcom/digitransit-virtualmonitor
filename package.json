{
  "name": "digitransit-stop-monitor",
  "version": "3.0.5",
  "description": "Real-time, updating public transport info display that aggregates OpenTripPlanner schedules for multiple stops",
  "license": "MIT",
  "contributors": [
    "Digitransit team"
  ],
  "private": true,
  "dependencies": {
    "@apollo/client": "^3.5.5",
    "@digitransit-component/digitransit-component-autosuggest": "7.1.5",
    "@digitransit-component/digitransit-component-dialog-modal": "^3.0.3",
    "@digitransit-component/digitransit-component-icon": "^2.0.2",
